# Default: local vision inference. No API key required.
HOGMORPH_PROVIDER=ollama
HOGMORPH_MODEL=qwen3-vl:4b
HOGMORPH_BASE_URL=http://127.0.0.1:11434
# Optional: OpenAI-compatible vision chat-completions service.
# HOGMORPH_PROVIDER=openai
# HOGMORPH_MODEL=your-vision-model
# HOGMORPH_BASE_URL=https://your-provider.example/v1
# HOGMORPH_API_KEY=configure-locally-never-commit
